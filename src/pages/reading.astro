---
import Layout from "../layouts/Layout.astro";
import ReadingCard from "../components/ReadingCard.astro";
import { readingPicks, readingEdition, studentReading } from "../data/reading";
const articles = [...readingPicks].sort((a, b) => b.date.localeCompare(a.date));
const publisherCount = new Set(articles.map((article) => article.publisher))
  .size;
---

<Layout
  title="Recommended Reading"
  description="Chen Gadi’s reading selection across quantum physics, machine learning, and science magazines, with recommended linear algebra resources for students."
>
  <section class="page-intro">
    <div class="mx-auto max-w-6xl px-6">
      <p class="edition-label">The reading room · {readingEdition}</p><h1>
        Recommended reading
      </h1><p>
        Ideas from quantum physics, machine learning, and the wider world of
        science. Magazine stories, interviews, and explainers, alongside
        resources for learning linear algebra.
      </p><div class="academic-actions">
        <a href="#physics" class="academic-primary"
          >Explore the reading selection ↓</a
        ><a href="#for-students" class="academic-secondary">For my students ↓</a
        >
      </div>
    </div>
  </section>
  <section
    id="physics"
    class="mx-auto max-w-6xl px-6 py-16 md:py-20 scroll-mt-24"
  >
    <div class="editorial-heading">
      <div>
        <p class="edition-label">October 2026 selection</p><h2>
          Quantum, physics &amp; machine learning.
        </h2>
      </div><p>
        {articles.length} reads from {publisherCount} publications, published between
        18 September and 18 October 2026. Each recommendation includes a source,
        date, and a short note on why I suggest it.
      </p>
    </div>
    <div id="reading-selection">
      <div
        class="reading-filters"
        role="group"
        aria-label="Filter recommended reading"
      >
        <button
          type="button"
          data-reading-filter="all"
          aria-pressed="true"
          aria-controls="reading-grid">All reading</button
        ><button
          type="button"
          data-reading-filter="physics"
          aria-pressed="false"
          aria-controls="reading-grid">Quantum &amp; physics</button
        ><button
          type="button"
          data-reading-filter="ml"
          aria-pressed="false"
          aria-controls="reading-grid">Machine learning &amp; AI</button>
      </div><p id="reading-results" class="reading-results" aria-live="polite">
        Showing all {articles.length} articles
      </p><div class="reading-grid" id="reading-grid">
        {articles.map((article) => <ReadingCard article={article} />)}
      </div>
    </div>
    <p class="source-note">
      Sources and publication dates checked on 18 October 2026. Links open the
      original publisher; some publishers may require a subscription. This is a
      dated selection, updated by hand.
    </p>
  </section>
  <section id="for-students" class="reading-students scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="editorial-heading">
        <div>
          <p class="edition-label">Recommended for students</p><h2>
            Linear Algebra resources
          </h2>
        </div><p>
          Choose a resource for the question you are working on. The course
          syllabus and class material remain your guide to what is assessed.
        </p>
      </div>
      <div class="resource-grid">
        {
          studentReading.map((item, i) => (
            <article class="resource-card">
              <>
                <span class="resource-index">0{i + 1}</span>
                <div>
                  <>
                    <p class="edition-label">{item.level}</p>
                    <h3>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.title}{" "}
                        <>
                          <span aria-hidden="true">↗</span>
                          <span class="sr-only"> (opens in a new tab)</span>
                        </>
                      </a>
                    </h3>
                    <p class="resource-author">{item.author}</p>
                    <p>{item.description}</p>
                    <span class="resource-format">{item.format}</span>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
      <div class="syllabus-callout">
        <div>
          <p class="edition-label">
            Electrical &amp; Electronics Engineering · 05091724
          </p><h3>Linear Algebra: English syllabus</h3><p>
            Topics, assessment rules, exam format, and bibliography for Semester
            A, 2026–2027.
          </p>
        </div><a
          href="/teaching/linear-algebra-electrical/syllabus"
          class="academic-primary">Read the syllabus ↗</a
        >
      </div>
    </div>
  </section>
</Layout>

<script>
  import "../scripts/reading-filter";
</script>
