---
import Layout from "../layouts/Layout.astro";
import AppDevelopment from "../components/AppDevelopment.astro";
import { getCollection } from "astro:content";
const papers = await getCollection("research", ({ data }) => !data.draft);
papers.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Research"
  description="Chen Gadi is completing an M.Sc. thesis in Physics under Prof. Yaron Oz at Tel Aviv University."
>
  <section class="page-intro">
    <div class="mx-auto max-w-6xl px-6">
      <p class="edition-label">Research · Tel Aviv University</p><h1>
        Research
      </h1><p>
        I am completing my master’s thesis under the supervision of Prof. Yaron
        Oz, as a member of his research group at Tel Aviv University.
      </p>
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <section class="research-focus" aria-label="Academic affiliation">
      <p class="academic-kicker">CURRENT ACADEMIC AFFILIATION</p><h2
        class="font-display text-3xl"
      >
        Prof. Yaron Oz’s research group
      </h2><div class="research-focus-grid">
        <div><span>DEGREE</span><strong>M.Sc. in Physics</strong></div><div>
          <span>SUPERVISOR</span><strong>Prof. Yaron Oz</strong>
        </div><div>
          <span>INSTITUTION</span><strong>Tel Aviv University</strong>
        </div>
      </div><a class="academic-secondary" href="/about">Academic profile ↗</a>
    </section>
    {
      papers.length > 0 && (
        <section>
          <>
            <h2 class="font-display text-3xl mb-6">
              Publications &amp; research notes
            </h2>
            <div class="space-y-4">
              {papers.map((paper) => (
                <article class="contact-route">
                  <h3 class="text-lg font-semibold mb-2">{paper.data.title}</h3>
                  <p>{paper.data.description}</p>
                  {paper.data.arxiv && (
                    <a
                      href={paper.data.arxiv}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-link mt-4"
                    >
                      Read on arXiv ↗
                    </a>
                  )}
                </article>
              ))}
            </div>
          </>
        </section>
      )
    }
    <div class="syllabus-callout">
      <div>
        <p class="edition-label">Public projects</p><h3>
          Code and teaching tools
        </h3><p>
          Explore the standalone projects and educational work shared on this
          site.
        </p>
      </div><a href="/projects" class="academic-secondary"
        >Browse projects ↗</a>
    </div>
  </div>
  <AppDevelopment />
</Layout>
