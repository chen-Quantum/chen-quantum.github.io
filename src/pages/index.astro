---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import ReadingCard from "../components/ReadingCard.astro";
import AppDevelopment from "../components/AppDevelopment.astro";
import { getCollection } from "astro:content";
import { youtubeVideos } from "../data/youtubeVideos";
import { tirgulim } from "../data/tirgulim";
import { readingPicks, readingEdition } from "../data/reading";
import { isUpcomingEvent } from "../data/eventStatus";

const allEvents = await getCollection(
  "communityEvents",
  ({ data }) => !data.draft,
);
const upcoming = allEvents
  .filter((e) => isUpcomingEvent(e.data))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);
const teaching = [
  {
    role: "Lecturer",
    title: "International Engineering",
    detail: "International Engineering Program at Tel Aviv University.",
    href: "/students",
    action: "Enter your classroom",
  },
  {
    role: "Teaching Assistant",
    title: "Linear Algebra",
    detail: "Electrical & Electronics Engineering and Biomedical Engineering.",
    href: "/teaching/linear-algebra",
    action: "Recordings & tutorials",
  },
];
---

<Layout
  title="Chen Gadi"
  description="Chen Gadi, M.Sc. student in Physics at Tel Aviv University, completing a thesis under Prof. Yaron Oz. Teaching, student resources, and quantum community events."
>
  <section class="academic-hero">
    <div class="mx-auto max-w-6xl px-6 academic-hero-grid">
      <div>
        <p class="academic-kicker">TEL AVIV UNIVERSITY · PHYSICS</p>
        <h1 class="font-display academic-name">Chen Gadi<span>.</span></h1>
        <p class="academic-lead">
          M.Sc. student in Physics.<br />Thesis supervised by Prof. Yaron Oz.
        </p>
        <p class="academic-bio">
          I am a master’s student in Physics and a member of Prof. Yaron Oz’s
          research group at Tel Aviv University. Alongside my studies, I
          lecture, teach linear algebra, and help bring the quantum community
          together.
        </p>
        <div class="academic-actions">
          <a href="/about" class="academic-primary"
            >Academic profile <span aria-hidden="true">↗</span></a
          ><a href="/teaching" class="academic-secondary"
            >Teaching &amp; materials</a>
        </div>
        <p class="academic-signature">Physics · Teaching · Quantum Community</p>
      </div>
      <aside class="academic-appointments" aria-label="Current academic roles">
        <div class="academic-panel-top">
          <span>CURRENTLY AT TAU</span><img
            src="/brand/logo.png"
            alt="Chen Gadi logo"
            width="48"
            height="48"
          />
        </div>
        <div class="academic-appointment">
          <span class="academic-number">01</span><div>
            <p class="academic-role">M.SC. THESIS · IN PROGRESS</p><h2>
              Physics
            </h2><p>Supervisor: Prof. Yaron Oz</p>
          </div>
        </div>
        <div class="academic-appointment">
          <span class="academic-number">02</span><div>
            <p class="academic-role">LECTURER</p><h2>
              International Engineering Program
            </h2><p>Tel Aviv University</p>
          </div>
        </div>
        <div class="academic-appointment">
          <span class="academic-number">03</span><div>
            <p class="academic-role">TEACHING ASSISTANT</p><h2>
              Linear Algebra
            </h2><p>Electrical Engineering · Biomedical Engineering</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
  <section class="student-entry" aria-label="Student hub">
    <div class="mx-auto max-w-6xl px-6 student-entry-inner">
      <div>
        <span class="academic-kicker">FOR MY STUDENTS</span><h2>
          Your questions belong here.
        </h2><p>
          Anonymous questions, peer answers, and private requests. Read every
          reply on the website.
        </p>
      </div><a href="/students" class="academic-primary"
        >Enter the Student Hub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="editorial-heading">
      <div>
        <p class="edition-label">Teaching &amp; learning</p><h2>
          Clarity in the classroom.<br />Support beyond it.
        </h2>
      </div><a class="text-link" href="/teaching">All teaching resources ↗</a>
    </div>
    <div class="teaching-feature-grid">
      {
        teaching.map((course, i) => (
          <article class="teaching-feature">
            <>
              <span class="resource-index">0{i + 1}</span>
              <p class="edition-label">{course.role}</p>
              <h3>{course.title}</h3>
              <p>{course.detail}</p>
              <a href={course.href} class="text-link">
                {course.action} ↗
              </a>
            </>
          </article>
        ))
      }
    </div>
    <div class="learning-strip">
      <p>
        <strong>{youtubeVideos.length}</strong> tutorial recordings <span
          aria-hidden="true">/</span
        >
        <strong>{tirgulim.length}</strong> practice sheets
      </p><a href="/teaching/linear-algebra-electrical/syllabus"
        >Electrical Engineering: English syllabus ↗</a
      ><a href="/reading#for-students">Recommended books &amp; resources ↗</a>
    </div>
  </section>
  {
    upcoming.length > 0 && (
      <section class="events-edition">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
          <>
            <div class="editorial-heading">
              <>
                <div>
                  <>
                    <p class="edition-label">On the calendar</p>
                    <h2>Next in quantum.</h2>
                  </>
                </div>
                <a class="text-link" href="/quantum-community/events">
                  All community events ↗
                </a>
              </>
            </div>
            <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {upcoming.map((event) => (
                <EventCard {...event.data} slug={event.id} />
              ))}
            </div>
            <p class="source-note">
              Save-the-date announcements and planned sessions are labelled
              separately. Programme details will be added when confirmed.
            </p>
          </>
        </div>
      </section>
    )
  }
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="editorial-heading">
      <div>
        <p class="edition-label">Reading room · {readingEdition}</p><h2>
          A few things I recommend.
        </h2>
      </div><a class="text-link" href="/reading"
        >The full reading selection ↗</a>
    </div><div class="reading-grid reading-grid-home">
      {
        readingPicks
          .slice(0, 2)
          .map((article) => <ReadingCard article={article} />)
      }
    </div>
  </section>
  <AppDevelopment />
  <section class="community-invitation">
    <div class="mx-auto max-w-6xl px-6 community-invitation-inner">
      <div>
        <p class="edition-label">TAU Quantum Community</p><h2>
          Beyond classical.<br /><em>Into quantum.</em>
        </h2><p>
          A student community connecting people through quantum science,
          conversations, and events, in collaboration with QuanTAU.
        </p><a class="academic-primary" href="/quantum-community"
          >Meet the community ↗</a>
      </div><div class="community-orbits" aria-hidden="true">
        <svg viewBox="0 0 360 300" fill="none"
          ><circle cx="180" cy="150" r="118" stroke="currentColor" opacity=".18"
          ></circle><ellipse
            cx="180"
            cy="150"
            rx="145"
            ry="55"
            transform="rotate(-35 180 150)"
            stroke="currentColor"></ellipse><ellipse
            cx="180"
            cy="150"
            rx="145"
            ry="55"
            transform="rotate(35 180 150)"
            stroke="currentColor"
            opacity=".5"></ellipse><circle
            cx="180"
            cy="150"
            r="8"
            fill="currentColor"></circle><circle
            cx="294"
            cy="59"
            r="5"
            fill="currentColor"></circle></svg
        ><span>QTC / QUANTAU / TEL AVIV UNIVERSITY</span>
      </div>
    </div>
  </section>
</Layout>
