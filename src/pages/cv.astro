---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="CV Unavailable"
  description="The curriculum vitae is currently unavailable."
  robots="noindex, nofollow"
>
  <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="max-w-xl">
      <span class="cv-lock" aria-hidden="true"
        ><svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><rect x="5" y="10" width="14" height="11" rx="2"></rect><path
            d="M8 10V7a4 4 0 018 0v3"></path><path d="M12 14v3"></path></svg
        ></span
      ><p class="edition-label">Academic profile</p><h1
        class="font-display text-4xl md:text-5xl mb-5"
      >
        CV currently unavailable.
      </h1><p class="text-slate-500 leading-relaxed mb-8">
        Viewing and downloading the CV are currently disabled.
      </p><a href="/about" class="academic-primary">View academic profile ↗</a>
    </div>
  </section>
</Layout>
