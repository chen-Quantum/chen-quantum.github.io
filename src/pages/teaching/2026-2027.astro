---
import { newestNumberedFirst } from "../../data/teachingOrder";
import Layout from "../../layouts/Layout.astro";
import TutorialPdfDownloads from "../../components/TutorialPdfDownloads.astro";
import CurrentLinearAlgebraRecordings from "../../components/CurrentLinearAlgebraRecordings.astro";
import { getCollection } from "astro:content";
import {
  academicYear,
  engineeringNotesPdf,
  engineeringNotesEnglishPdf,
  engineeringAppendixPages,
  engineeringTutorialPdf,
  engineeringLogicAppendixPdf,
  engineeringTutorials,
} from "../../data/academicYear2026";
const courses = (
  await getCollection(
    "teaching",
    ({ data }) => !data.draft && data.status === "active",
  )
).sort(
  (a, b) =>
    (a.data.role === "Lecturer" ? 0 : 1) -
      (b.data.role === "Lecturer" ? 0 : 1) ||
    a.data.title.localeCompare(b.data.title),
);

---

<Layout
  title={`Courses ${academicYear}`}
  description="Courses and tutorial notes for the 2026–2027 academic year. Linear Algebra for engineering students, with a topic-by-topic guide to Chen Gadi's notes."
>
  <section class="page-intro">
    <div class="mx-auto max-w-6xl px-6">
      <a class="year-back" href="/teaching">← Teaching</a>
      <p class="edition-label">Teaching · Academic year 5787</p>
      <h1>Courses <span class="cv-title-dot">2026–2027</span></h1>
      <p>
        Find your classroom, browse the tutorial notes, or open an activity in
        English or Hebrew.
      </p>
      <div class="academic-actions mt-6">
        <a class="academic-primary" href={engineeringNotesEnglishPdf} target="_blank" rel="noopener">Full booklet · English PDF ↗</a>
        <a class="academic-secondary" href={engineeringNotesPdf} target="_blank" rel="noopener">Full booklet · Hebrew PDF ↗</a>
        <a class="text-link" href="#new-recordings">Recordings by track &amp; practice PDFs ↓</a>
        <a class="text-link" href="#tutorial-downloads">Individual tutorial PDFs ↓</a>
        <a class="text-link" href="#year-courses">Find your classroom ↓</a>
        <a class="text-link" href="/students">Student Hub ↗</a>
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
    <section aria-labelledby="year-courses">
      <p class="edition-label">This academic year</p><h2
        id="year-courses"
        class="font-display text-3xl mb-7"
      >
        Courses &amp; classrooms
      </h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          courses.map(({ data: c }) => (
            <article class="contact-route flex flex-col" data-course-id={c.courseId}>
              <p class="academic-kicker">
                {c.role} · {academicYear}
              </p>
              <h3 class="font-display text-2xl mt-4 mb-4">{c.title}</h3>
              <p class="flex-1">{c.description}</p>
              <div class="academic-actions mt-6">
                <a
                  class="academic-primary"
                  href={`/students?course=${c.courseId}`}
                >
                  Enter classroom ↗
                </a>
                {c.courseId === "international-engineering" && (
                  <>
                    <a class="text-link" href="/teaching/#international-engineering-2026-2027">
                      Featured international course: lecture notes &amp; tutorial PDFs ↗
                    </a>
                    <a class="text-link" href={engineeringNotesEnglishPdf} target="_blank" rel="noopener">
                      Complete tutorial booklet · English PDF ↗
                    </a>
                    <a class="text-link" href="/teaching/international-engineering/#tutorial-downloads">
                      Individual tutorial PDFs · English only ↗
                    </a>
                    <a class="text-link" href="/teaching/international-engineering/">
                      English lecture notes &amp; course materials ↗
                    </a>
                  </>
                )}
                {c.courseId === "linear-algebra-biomedical" && (
                  <a class="text-link" href="#new-recordings-biomedical">
                    Biomedical · Recordings &amp; practice sheets ↓
                  </a>
                )}
                {c.courseId === "linear-algebra-electrical" && (
                  <a class="text-link" href="#new-recordings-electrical">
                    Electrical · Recordings &amp; practice sheets ↓
                  </a>
                )}
                {c.courseId.startsWith("linear-algebra-") && (
                  <a class="text-link" href="#linear-algebra">
                    Tutorial PDFs · English &amp; Hebrew ↓
                  </a>
                )}
                {c.courseId === "linear-algebra-electrical" && (
                  <a
                    class="text-link"
                    href="/teaching/linear-algebra-electrical/syllabus"
                  >
                    English syllabus ↗
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>
    <CurrentLinearAlgebraRecordings />
    <section
      id="linear-algebra"
      class="mt-16 scroll-mt-24"
      aria-labelledby="notes-title"
      data-tutorial-discovery
    >
      <div class="research-focus">
        <p class="edition-label">
          Linear Algebra for Engineering · {academicYear}
        </p>
        <h2 id="notes-title" class="font-display text-3xl mb-4">
          Linear Algebra tutorial notes
        </h2>
        <p>
          The complete handbook by Chen Gadi collects recitation notes
          from previous years, with 13 tutorials and an appendix on logic and
          proof methods. Their numbering and topic order may differ from this
          year's lectures. The complete booklet is available in English and Hebrew;
          the topic guide below is in English. These are study notes, not a replacement
          for the lectures or official course announcements.
        </p>
        <div class="academic-actions mt-6">
          <a
            class="academic-primary"
            href={engineeringNotesEnglishPdf}
            target="_blank"
            rel="noopener">Full booklet · English PDF ↗</a>
          <a class="academic-secondary" href={engineeringNotesPdf} target="_blank" rel="noopener">
            Full booklet · Hebrew PDF ↗
          </a><a class="academic-secondary" href="/students?mode=logistics"
            >Course logistics ↗</a>
        </div>
      </div>
      <nav class="study-tools" aria-label="Linear Algebra activities">
        <div>
          <h3>Interactive tutorial lab</h3>
          <p>Activities for all {engineeringTutorials.length} tutorials.</p>
          <div class="study-language-links">
            <a href="/teaching/linear-algebra/lab/en/">English <span aria-hidden="true">↗</span></a>
            <a href="/teaching/linear-algebra/lab">Hebrew <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div>
          <h3>Guided LLM activities</h3>
          <p>Instructions, exercises, and a personal notebook.</p>
          <div class="study-language-links">
            <a href="/teaching/linear-algebra/llm/en/">English <span aria-hidden="true">↗</span></a>
            <a href="/teaching/linear-algebra/llm">Hebrew <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </nav>
      <div id="tutorial-downloads" class="mt-8 flex items-baseline justify-between gap-4 flex-wrap scroll-mt-24">
        <h3 class="font-display text-2xl">Individual tutorial PDFs</h3><p
          class="text-sm text-slate-500"
        >
          Latest tutorial numbers first. Download a single tutorial in English or Hebrew.
        </p>
      </div>
      <div class="tutorial-search" data-discovery-controls hidden>
        <label for="tutorial-search">Find a tutorial</label>
        <div class="tutorial-search-row">
          <input
            id="tutorial-search"
            type="search"
            name="tutorial"
            placeholder="Topic or number, e.g. eigenvalues or 11"
            aria-controls="tutorial-list"
            aria-describedby="tutorial-results"
            autocomplete="off"
            data-tutorial-search
          />
          <button type="button" data-tutorial-reset disabled>Clear</button>
        </div>
        <p id="tutorial-results" role="status" aria-live="polite" aria-atomic="true">
          Showing all {engineeringTutorials.length} tutorials
        </p>
      </div>
      <ol
        id="tutorial-list"
        class="tutorial-list mt-5 grid gap-4 md:grid-cols-2"
        aria-label="Linear Algebra tutorials"
      >
        {
          newestNumberedFirst(engineeringTutorials).map((t) => (
            <li
              class="rounded-2xl border border-slate-200 bg-white p-6 flex gap-4 items-start"
              id={`tutorial-${t.number}`}
              data-tutorial={t.number}
              data-tutorial-search-text={`Tutorial ${t.number} ${t.title}`}
            >
              <span
                class="font-display text-3xl text-indigo-600 tabular-nums"
                aria-hidden="true"
              >
                {String(t.number).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                  <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">
                    Tutorial {t.number}
                  </p>
                  <h4 class="font-semibold text-slate-900 mb-3">{t.title}</h4>
                  <TutorialPdfDownloads
                    label={`Tutorial ${t.number}`}
                    englishPdf={engineeringTutorialPdf(t.number, "en")}
                    hebrewPdf={engineeringTutorialPdf(t.number, "he")}
                  />
                  <div class="booklet-page-links" aria-label={`Tutorial ${t.number} in the full booklet`}>
                    <span>Full booklet:</span>
                    <a href={`${engineeringNotesEnglishPdf}#page=${t.englishPage}`} target="_blank" rel="noopener">
                      English p. {t.englishPage} ↗
                    </a>
                    <a href={`${engineeringNotesPdf}#page=${t.page}`} target="_blank" rel="noopener">
                      Hebrew p. {t.page} ↗
                    </a>
                  </div>
                  <div class="tutorial-activity-links">
                    <p>Interactive activity</p>
                    <div class="study-language-links">
                      <a href={`/teaching/linear-algebra/lab/en/#tutorial-${t.number}`} aria-label={`Tutorial ${t.number} activity in English`}>
                        English <span aria-hidden="true">↗</span>
                      </a>
                      <a href={`/teaching/linear-algebra/lab#tutorial-${t.number}`} aria-label={`Tutorial ${t.number} activity in Hebrew`}>
                        Hebrew <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </div>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="tutorial-empty" data-tutorial-empty hidden>
        <h4>No matching tutorials</h4>
        <p>Try a different topic or a tutorial number from 1 to {engineeringTutorials.length}.</p>
        <button type="button" class="academic-secondary" data-tutorial-reset>Show all tutorials</button>
      </div>
      <p class="mt-6 text-sm text-slate-500">
        Full-booklet page numbers count from the cover. Use the PDF bookmarks
        if your viewer opens at the beginning.
      </p>
      <article class="logic-downloads mt-6" aria-labelledby="logic-downloads-title">
        <h3 id="logic-downloads-title" class="font-display text-xl mb-3">Appendix: logic and proof methods</h3>
        <TutorialPdfDownloads label="the logic and proof methods appendix" englishPdf={engineeringLogicAppendixPdf.en} hebrewPdf={engineeringLogicAppendixPdf.he} />
        <div class="booklet-page-links">
          <span>Full booklet:</span>
          <a href={`${engineeringNotesEnglishPdf}#page=${engineeringAppendixPages.en}`} target="_blank" rel="noopener">English p. {engineeringAppendixPages.en} ↗</a>
          <a href={`${engineeringNotesPdf}#page=${engineeringAppendixPages.he}`} target="_blank" rel="noopener">Hebrew p. {engineeringAppendixPages.he} ↗</a>
        </div>
      </article>
      <div class="academic-actions mt-6">
        <a class="text-link" href="/teaching/linear-algebra"
          >Earlier tutorial recordings ↗</a>
      </div>
    </section>
    <section class="mt-16" id="earlier-materials">
      <h2 class="font-display text-2xl mb-4">Earlier materials</h2><p
        class="text-slate-600 mb-5"
      >
        Recordings and practice sheets from earlier teaching remain available in
        the teaching archive.
      </p><a class="academic-secondary" href="/teaching#hedva-2"
        >Calculus 2 &amp; recording archive ↗</a>
    </section>
  </div>
  <script>
    import "../../scripts/teaching-discovery";
  </script>
</Layout>

<style>
  .year-back { display: inline-flex; color: #43624f; font-size: 0.8125rem; font-weight: 600; margin-bottom: 1.5rem; }
  .year-back:hover { text-decoration: underline; text-underline-offset: 4px; }
  #year-courses, .tutorial-list > li { scroll-margin-top: 7rem; }
  .booklet-page-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.75rem; margin-top: 0.75rem; color: #657367; font-size: 0.75rem; }
  .booklet-page-links a { color: #43624f; text-decoration: underline; text-underline-offset: 3px; }
  .logic-downloads { padding: 1.25rem 1.5rem; border: 1px solid #dce4d6; border-radius: 10px; background: #fafbf7; }
  .study-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 1.5rem; border: 1px solid #dce4d6; background: #dce4d6; border-radius: 10px; overflow: hidden; }
  .study-tools > div { padding: 1.25rem 1.5rem; background: #fafbf7; }
  .study-tools h3 { color: #294437; font-size: 0.9375rem; font-weight: 650; }
  .study-tools p { margin: 0.35rem 0 0.75rem; color: #59695e; font-size: 0.8125rem; line-height: 1.7; }
  .study-language-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.1rem; }
  .study-language-links a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 36px; color: #1b4e3f; font-size: 0.8125rem; font-weight: 650; text-decoration: underline; text-decoration-color: #c5d3c7; text-underline-offset: 4px; }
  .study-language-links a:hover { text-decoration-color: currentColor; }
  .tutorial-search { margin-top: 1.25rem; }
  .tutorial-search label { display: block; margin-bottom: 0.5rem; font-size: 0.8125rem; font-weight: 650; color: #294437; }
  .tutorial-search-row { display: flex; align-items: stretch; gap: 0.625rem; max-width: 44rem; }
  .tutorial-search input { min-width: 0; flex: 1; border: 1px solid #bdcbbb; border-radius: 8px; background: white; padding: 0.875rem 1rem; font: inherit; font-size: 0.875rem; color: #203c31; }
  .tutorial-search input::placeholder { color: #6b756e; opacity: 1; }
  .tutorial-search input:focus-visible, .tutorial-search button:focus-visible, .study-language-links a:focus-visible { outline: 3px solid #8cb7a1; outline-offset: 3px; }
  .tutorial-search button { border: 1px solid #c6d2c4; padding: 0.75rem 1rem; background: #fafbf7; border-radius: 8px; color: #294437; font-weight: 600; font-size: 0.8125rem; cursor: pointer; }
  .tutorial-search button:disabled { opacity: 0.5; cursor: default; }
  #tutorial-results { margin-top: 0.75rem; color: #59695e; font-size: 0.8125rem; }
  .tutorial-list > li { transition: border-color 0.15s; }
  .tutorial-list > li:hover { border-color: #adbfaf; }
  .tutorial-activity-links { margin-top: 1rem; padding-top: 0.875rem; border-top: 1px solid #e9eee7; }
  .tutorial-activity-links > p { color: #647067; font-size: 0.75rem; margin-bottom: 0.15rem; }
  .tutorial-empty { margin-top: 1.25rem; padding: 2rem; border: 1px dashed #bdcbbb; border-radius: 10px; background: #fafbf7; }
  .tutorial-empty h4 { font-weight: 650; color: #294437; }
  .tutorial-empty p { margin: 0.5rem 0 1rem; font-size: 0.875rem; color: #59695e; }
  [data-tutorial-discovery] [hidden] { display: none !important; }
  @media (max-width: 640px) {
    .study-tools { grid-template-columns: minmax(0, 1fr); }
    .study-tools > div { padding: 1.125rem; }
    .tutorial-search input { padding-inline: 0.75rem; }
    .tutorial-list > li { padding: 1.25rem; gap: 0.875rem; }
  }
  @media (prefers-reduced-motion: reduce) { .tutorial-list > li { transition: none; } }
</style>
