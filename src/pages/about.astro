---
import Layout from "../layouts/Layout.astro";
import AppDevelopment from "../components/AppDevelopment.astro";
const roles = [
  {
    label: "01 / POSTGRADUATE STUDIES",
    title: "M.Sc. in Physics",
    detail:
      "Completing a master’s thesis under the supervision of Prof. Yaron Oz at Tel Aviv University. Member of Prof. Oz’s research group.",
  },
  {
    label: "02 / LECTURING",
    title: "International Engineering Program",
    detail:
      "Lecturer in Tel Aviv University’s International Engineering Program.",
  },
  {
    label: "03 / TUTORIALS",
    title: "Linear Algebra",
    detail:
      "Teaching assistant for Electrical & Electronics Engineering and Biomedical Engineering.",
  },
];
---

<Layout
  title="Academic Profile"
  description="Chen Gadi, M.Sc. student in Physics at Tel Aviv University, completing a thesis under Prof. Yaron Oz. Academic background, teaching, and community."
>
  <section class="page-intro">
    <div class="mx-auto max-w-6xl px-6">
      <p class="edition-label">Academic profile</p><h1>
        Physics.<br /><em>People. Possibilities.</em>
      </h1><p>
        I am Chen Gadi, an M.Sc. student in Physics at Tel Aviv University,
        completing a thesis under Prof. Yaron Oz.
      </p>
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="profile-grid">
      <div>
        <p class="edition-label">At Tel Aviv University</p><h2
          class="font-display text-3xl md:text-4xl text-slate-900"
        >
          Research and teaching,<br />side by side.
        </h2><p class="profile-description">
          Alongside my master’s studies, I teach engineering students and work
          with the quantum community. I aim to make the site a useful place for
          course material, questions, and conversations.
        </p><a href="/students" class="academic-primary"
          >Contact me through the site ↗</a>
      </div><div class="profile-roles">
        {
          roles.map((role) => (
            <article>
              <>
                <p class="edition-label">{role.label}</p>
                <h3>{role.title}</h3>
                <p>{role.detail}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
    <section class="education-section">
      <p class="edition-label">Education</p><div class="education-row">
        <span>2024–present</span><div>
          <h3>M.Sc. in Physics</h3><p>
            Tel Aviv University · Thesis supervisor: Prof. Yaron Oz
          </p>
        </div><span class="status-pill">In progress</span>
      </div><div class="education-row">
        <span>2020–2024</span><div>
          <h3>B.Sc. in Mathematics and Physics</h3><p>
            Tel Aviv University · Magna Cum Laude · Dean’s List 2024
          </p>
        </div>
      </div>
    </section>
    <div class="syllabus-callout">
      <div>
        <p class="edition-label">Beyond the classroom</p><h3>
          The TAU Quantum Community
        </h3><p>
          Connecting students and researchers through quantum science events and
          discussions.
        </p>
      </div><a href="/quantum-community" class="academic-secondary"
        >Community &amp; events ↗</a>
    </div>
  </div>
  <AppDevelopment />
</Layout>
