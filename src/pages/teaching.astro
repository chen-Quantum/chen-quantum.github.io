---
import Layout from "../layouts/Layout.astro";
import { practiceTopicsEn, englishVideoTitle } from "../data/englishTeaching";
import LiteYouTube from "../components/LiteYouTube.astro";
import PdfPreview from "../components/PdfPreview.astro";
import PdfDownloadGate from "../components/PdfDownloadGate.astro";
import { TEACHING_PDF_DOWNLOAD_CODE } from "../data/teachingAccess";
import { getCollection } from "astro:content";
import { tirgulim } from "../data/tirgulim";
import { teachingCourses } from "../data/courses";
import { engineeringTutorials, engineeringNotesPdf, engineeringNotesEnglishPdf } from "../data/academicYear2026";
import {
  youtubeVideos,
  hedva2Videos,
  linearAlgebraVideos,
  groupTheoryVideos,
  unknownVideos,
  videosForPractice,
} from "../data/youtubeVideos";

const allTeaching = await getCollection("teaching", ({ data }) => !data.draft);
const activeCourses = allTeaching
  .filter((c) => c.data.status === "active")
  .sort((a, b) =>
    (a.data.role === "Lecturer" ? 0 : 1) -
      (b.data.role === "Lecturer" ? 0 : 1) ||
    a.data.title.localeCompare(b.data.title),
  );

function countFor(courseId: string) {
  if (courseId === "calculus-2")
    return { materials: tirgulim.length, videos: hedva2Videos.length };
  if (courseId === "linear-algebra-electrical")
    return {
      materials: engineeringTutorials.length,
      videos: linearAlgebraVideos.filter((v) => v.track.includes("Electrical"))
        .length,
    };
  if (courseId === "linear-algebra-biomedical")
    return {
      materials: engineeringTutorials.length,
      videos: linearAlgebraVideos.filter((v) => v.track.includes("Biomedical"))
        .length,
    };
  return { materials: 0, videos: 0 };
}

// Linear Algebra recordings grouped by tutorial number (newest first) + exam question.
const laTutorialNumbers = [13, 12, 11, 10, 9, 8];
const laGroups = laTutorialNumbers
  .map((n) => ({
    n,
    videos: linearAlgebraVideos.filter((v) => v.laTutorial === n),
  }))
  .filter((g) => g.videos.length > 0);
const laExam = linearAlgebraVideos.filter((v) => v.isExamQuestion);

// Course filters: render a chip only for courses that actually have content
// (videos or practice sheets). Future courses in the registry stay hidden until
// material is classified into them.
const filterCourses = teachingCourses.filter(
  (c) =>
    youtubeVideos.some((v) => v.courseId === c.id) ||
    tirgulim.some((t) => t.courseId === c.id),
);

// Soft download code for full open / download of teaching PDFs. The inline
// preview stays visible without a code; only opening / downloading the full
// PDF requires it. This is classroom UX, not security: the code is in the
// page source and the PDF URL is public.
const DOWNLOAD_CODE = TEACHING_PDF_DOWNLOAD_CODE;

// Show the newest practice sheet first. Sort by the trailing tutorial number
// in the id (tirgul1 → 1, tirgul6 → 6), so tirgul6 appears first today and
// any future tirgul7+ will lead automatically.
const tirgulimNewestFirst = [...tirgulim].sort((a, b) => {
  const an = parseInt(a.id.replace(/^tirgul/, ""), 10) || 0;
  const bn = parseInt(b.id.replace(/^tirgul/, ""), 10) || 0;
  return bn - an;
});
---

<Layout
  title="Teaching"
  description="Teaching by Chen Gadi at Tel Aviv University: linear algebra and calculus 2 (Hedva 2) for engineering students. Practice sheets and tutorial recordings."
>
  <!-- Page header -->
  <section class="page-intro">
    <div class="mx-auto max-w-6xl px-6">
      <p class="edition-label">Tel Aviv University</p>
      <h1>Teaching &amp; course materials</h1>
      <p>
        Course classrooms, tutorial notes, recordings, and interactive
        activities for engineering students.
      </p>
      <div class="academic-actions mt-6">
        <a href="/teaching/2026-2027" class="academic-primary">Courses 2026–2027 ↗</a>
        <a href="/students" class="academic-secondary">Student Hub ↗</a>
        <a href="#recording-archive" class="text-link">Earlier materials ↓</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-10" id="academic-year-2026-2027" aria-label="Student resources">
    <nav class="teaching-shortcuts" aria-label="Study shortcuts">
      <div>
        <p class="shortcut-meta">2026–2027 · English &amp; Hebrew PDFs</p>
        <h2>Tutorial notes</h2>
        <p>{engineeringTutorials.length} Linear Algebra tutorials, with explanations and solutions.</p>
        <div class="shortcut-links">
          <a href={engineeringNotesEnglishPdf} target="_blank" rel="noopener">Full English booklet ↗</a>
          <a href={engineeringNotesPdf} target="_blank" rel="noopener">Full Hebrew booklet ↗</a>
        </div>
        <a href="/teaching/2026-2027/#tutorial-downloads">Individual tutorial PDFs ↗</a>
      </div>
      <div>
        <p class="shortcut-meta">Interactive activities</p>
        <h2>Tutorial lab</h2>
        <p>Explore the concepts in each tutorial.</p>
        <div class="shortcut-links">
          <a href="/teaching/linear-algebra/lab/en/">English ↗</a>
          <a href="/teaching/linear-algebra/lab">Hebrew ↗</a>
        </div>
      </div>
      <div>
        <p class="shortcut-meta">Exercises &amp; notebook</p>
        <h2>Guided LLM activities</h2>
        <p>Work through the activities and record your answers.</p>
        <div class="shortcut-links">
          <a href="/teaching/linear-algebra/llm/en/">English ↗</a>
          <a href="/teaching/linear-algebra/llm">Hebrew ↗</a>
        </div>
      </div>
    </nav>
  </section>
  <!-- Current courses -->
  <div class="mx-auto max-w-6xl px-6 py-12 md:py-14" data-teaching-archive>
    <div class="course-heading">
      <div>
        <p class="edition-label">Academic year 5787 · 2026–2027</p>
        <h2 class="font-display text-3xl">Find your classroom</h2>
      </div>
      <p>Questions and private requests are answered in the Student Hub.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        activeCourses.map((c) => {
          const { materials, videos } = countFor(c.data.courseId);
          return (
            <article class="flex flex-col p-6 bg-white rounded-2xl border border-slate-200 hover:border-slate-300 hover:shadow-sm transition-all" data-course-id={c.data.courseId}>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[0.65rem] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full text-emerald-700 bg-emerald-50 border border-emerald-200">
                  {c.data.role === "Lecturer"
                    ? "Lecturer"
                    : "Teaching Assistant"}
                </span>
              </div>
              <h3 class="text-base font-semibold text-slate-900 mb-2 leading-snug">
                {c.data.title}
              </h3>
              <p class="text-sm text-slate-500 leading-relaxed mb-4 flex-1">
                {c.data.description}
              </p>
              {c.data.audience.length > 0 && (
                <div class="mb-4">
                  <p class="text-[0.65rem] font-semibold text-slate-400 uppercase tracking-wide mb-1.5">
                    Audience
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {c.data.audience.map((a) => (
                      <span class="text-[0.65rem] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full">
                        {a}
                      </span>
                    ))}
                  </div>
                </div>
              )}
              {c.data.courseId === "international-engineering" && (
                <div class="mb-4 grid gap-2">
                  <a class="text-link" href={engineeringNotesEnglishPdf} target="_blank" rel="noopener">Full tutorial booklet · English PDF ↗</a>
                  <a class="text-link" href="/teaching/international-engineering/#tutorial-downloads">Individual tutorial PDFs · English &amp; Hebrew ↗</a>
                  <a class="text-link" href="/teaching/international-engineering/">English lecture notes &amp; course materials ↗</a>
                </div>
              )}
              {c.data.courseId === "linear-algebra-electrical" && (
                <a
                  class="text-link mb-4"
                  href="/teaching/linear-algebra-electrical/syllabus"
                >
                  English syllabus ↗
                </a>
              )}
              {c.data.courseId.startsWith("linear-algebra-") && (
                <a
                  class="text-link mb-4"
                  href="/teaching/2026-2027#linear-algebra"
                >
                  2026–2027 tutorial notes (Hebrew) ↗
                </a>
              )}
              <a class="academic-primary self-start mb-5" href={`/students?course=${c.data.courseId}`}>
                Enter classroom ↗
              </a>
              {(materials > 0 || videos > 0) && <div class="mt-auto pt-3 border-t border-slate-100 flex items-center gap-4 text-xs text-slate-500">
                <span>
                  {c.data.courseId.startsWith("linear-algebra-")
                    ? `${materials} tutorials in notes`
                    : `${materials} practice sheet${materials === 1 ? "" : "s"}`}
                </span>
                <span>·</span>
                <span>
                  {videos} recording{videos === 1 ? "" : "s"}
                </span>
              </div>}
            </article>
          );
        })
      }
    </div>

    <div class="syllabus-callout">
      <div>
        <p class="edition-label">
          Linear Algebra · Electrical &amp; Electronics Engineering
        </p><h3>Linear Algebra: English syllabus</h3><p>
          Course 05091724: topics, assessment, exam rules, and bibliography for
          Semester A, 2026–2027.
        </p>
      </div><div class="academic-actions">
        <a
          class="academic-primary"
          href="/teaching/linear-algebra-electrical/syllabus"
          >English syllabus ↗</a
        ><a class="academic-secondary" href="/reading#for-students"
          >Recommended resources ↗</a
        >
      </div>
    </div>

    <div class="archive-heading" id="recording-archive">
      <p class="edition-label">Earlier teaching</p>
      <h2 class="font-display text-3xl">Practice sheets &amp; recordings</h2>
      <p>Browse the archive by course. Current tutorial notes are on the <a class="text-link" href="/teaching/2026-2027#linear-algebra">2026–2027 page</a>.</p>
      <p class="archive-access-note">Recordings are unlisted YouTube videos. Anyone with a recording link can view it.</p>
    </div>
    <!-- ─── Course filter ───────────────────────────────────────── -->
    {
      filterCourses.length > 1 && (
        <div class="archive-filter" data-course-filter hidden>
          <p class="text-xs font-semibold text-slate-600 uppercase tracking-widest mb-3" id="archive-filter-label">
            Browse by course
          </p>
          <div class="flex flex-wrap gap-2" role="group" aria-labelledby="archive-filter-label">
            <button
              type="button"
              data-course="all"
              aria-pressed="true"
            >
              All courses
            </button>
            {filterCourses.map((c) => (
              <button
                type="button"
                data-course={c.id}
                aria-pressed="false"
              >
                {c.tag}
              </button>
            ))}
          </div>
          <p data-course-results role="status" aria-live="polite" aria-atomic="true">Showing all courses</p>
        </div>
      )
    }

    <!-- ─── Hedva 2 ─────────────────────────────────────────────── -->
    <section
      class="mt-10 md:mt-12 scroll-mt-24"
      id="hedva-2"
      data-course-section="hedva2"
    >
      <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
        <h2 class="font-display text-2xl md:text-3xl text-slate-900">
          Calculus 2 · Hedva 2: practice sessions
        </h2>
      </div>
      <p class="text-sm text-slate-500 leading-relaxed max-w-3xl mb-8">
        Practice sessions covering sequences and series of functions, power
        series, multivariable foundations, and differentiability. Each session
        has a practice sheet (PDF) and full recordings across the engineering
        tracks.
      </p>

      <div class="space-y-6">
        {
          tirgulimNewestFirst.map((t) => {
            const vids = videosForPractice(t.id);
            return (
              <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 scroll-mt-24" id={t.id}>
                <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
                  <div>
                    <p class="text-xs font-semibold text-slate-500 mb-1">
                      Tutorial {t.id.replace("tirgul", "")}
                    </p>
                    <p class="text-base font-semibold text-slate-900">
                      {t.titleEn}
                    </p>
                  </div>
                  <div class="flex-shrink-0">
                    <PdfDownloadGate
                      pdfPath={t.pdfPath}
                      code={DOWNLOAD_CODE}
                      label="Practice sheet · Hebrew PDF"
                    />
                  </div>
                </div>

                <div class="flex flex-wrap gap-1.5 mb-4" dir="ltr">
                  {(practiceTopicsEn[t.id] ?? []).map((tp) => (
                    <span class="text-[0.7rem] font-medium text-slate-600 bg-slate-100 px-2.5 py-1 rounded-full">
                      {tp}
                    </span>
                  ))}
                </div>

                <div class="mb-6">
                  <PdfPreview
                    pdfPath={t.pdfPath}
                    title={t.titleEn}
                    downloadCode={DOWNLOAD_CODE}
                  />
                </div>

                {vids.length > 0 && (
                  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {vids.map((v) => (
                      <LiteYouTube
                        videoId={v.videoId}
                        title={v.title}
                        thumbnail={v.thumbnail}
                        embedUrl={v.embedUrl}
                        url={v.url}
                        duration={v.duration}
                        track={v.track}
                      />
                    ))}
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- ─── Linear Algebra ──────────────────────────────────────── -->
    <section
      class="mt-16 md:mt-20 scroll-mt-24"
      id="linear-algebra"
      data-course-section="linear-algebra"
    >
      <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
        <h2 class="font-display text-2xl md:text-3xl text-slate-900">
          Linear Algebra: tutorial recordings
        </h2>
      </div>
      <p class="text-sm text-slate-500 leading-relaxed max-w-3xl mb-4">
        Full tutorial recordings across the electrical and biomedical
        engineering tracks (tutorials 8–13), plus worked exam questions. The
        2026–2027 tutorial notes are available on the <a
          class="text-link"
          href="/teaching/2026-2027#linear-algebra"
          >current academic year page</a
        >.
      </p>
      <p class="mb-4">
        <a
          href="/teaching/linear-algebra"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-700 hover:text-indigo-900"
        >
          View full Linear Algebra page →
        </a>
      </p>

      <div class="mb-8 max-w-2xl">
        <a
          href="/teaching/linear-algebra#songs"
          class="group block p-4 rounded-xl border border-slate-200 bg-slate-50 hover:border-indigo-200 hover:bg-indigo-50/30 transition-colors"
        >
          <div class="flex items-baseline justify-between flex-wrap gap-2 mb-1">
            <p class="text-sm font-semibold text-slate-900">
              Linear Algebra songs / memory aids
            </p>
            <span
              class="text-[0.65rem] font-semibold text-slate-500 bg-white border border-slate-200 px-2 py-0.5 rounded-full"
              dir="ltr"
            >
              Span Of Consciousness (EP)
            </span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Songs and memory aids for remembering linear algebra ideas.
          </p>
          <p
            class="mt-2 text-xs font-semibold text-indigo-700 group-hover:text-indigo-900"
          >
            Listen &amp; watch →
          </p>
        </a>
      </div>

      <div class="space-y-10">
        {
          laGroups.map((g) => (
            <div>
              <p class="text-sm font-semibold text-slate-900 mb-4">
                Tutorial {g.n}
              </p>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {g.videos.map((v) => (
                  <LiteYouTube
                    videoId={v.videoId}
                    title={v.title}
                    thumbnail={v.thumbnail}
                    embedUrl={v.embedUrl}
                    url={v.url}
                    duration={v.duration}
                    track={v.track}
                    note={v.sessionNote}
                  />
                ))}
              </div>
            </div>
          ))
        }

        {
          laExam.length > 0 && (
            <div>
              <p class="text-sm font-semibold text-slate-900 mb-4">
                Worked exam questions
              </p>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {laExam.map((v) => (
                  <LiteYouTube
                    videoId={v.videoId}
                    title={v.title}
                    thumbnail={v.thumbnail}
                    embedUrl={v.embedUrl}
                    url={v.url}
                    duration={v.duration}
                    track={v.track}
                  />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </section>

    <!-- ─── Group Theory (renders only if there's content) ─────── -->
    {
      groupTheoryVideos.length > 0 && (
        <section
          class="mt-16 md:mt-20 scroll-mt-24"
          id="group-theory"
          data-course-section="group-theory"
        >
          <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
            <h2 class="font-display text-2xl md:text-3xl text-slate-900">
              Group Theory: worked solutions
            </h2>
          </div>
          <p class="text-sm text-slate-500 leading-relaxed max-w-3xl mb-8">
            Selected worked solutions in group theory. New videos are added as
            they are produced.
          </p>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {groupTheoryVideos.map((v) => (
              <LiteYouTube
                videoId={v.videoId}
                title={v.title}
                thumbnail={v.thumbnail}
                embedUrl={v.embedUrl}
                url={v.url}
                duration={v.duration}
                track={v.track}
                note={v.sessionNote}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- ─── Needs classification (admin-only; renders only if non-empty) ─── -->
    {
      unknownVideos.length > 0 && (
        <section class="mt-16 md:mt-20" data-course-section="unknown">
          <div class="rounded-2xl border border-dashed border-amber-300 bg-amber-50/40 p-6">
            <p class="text-xs font-semibold text-amber-700 uppercase tracking-widest mb-2">
              Needs classification
            </p>
            <p class="text-sm text-slate-600 leading-relaxed max-w-3xl mb-4">
              {unknownVideos.length} playlist recording
              {unknownVideos.length === 1 ? "" : "s"} could not be confidently
              matched to a course from the title alone. Listed here for manual
              review: not shown anywhere else on the site.
            </p>
            <ul class="space-y-1.5">
              {unknownVideos.map((v) => (
                <li class="text-sm" dir="ltr">
                  <a
                    href={v.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-600 hover:text-indigo-700"
                  >
                    {englishVideoTitle(v)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Get in touch -->
    <section class="mt-16 md:mt-20">
      <div
        class="rounded-2xl border border-indigo-100 bg-indigo-50/40 p-8 max-w-3xl"
      >
        <h2 class="font-display text-xl md:text-2xl text-slate-900 mb-2">
          Questions, missing materials, or course logistics?
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed mb-5">
          Ask anonymously on your class board, or open a private request for a
          missing sheet, recording, schedule change, or personal matter. Replies
          appear in the Student Hub.
        </p>
        <a
          href="/students"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors"
        >
          Open the Student Hub →
        </a>
      </div>
    </section>
  </div>

  {
    /* Video classification note (developer-facing): 44 videos are classified.
     17 Hedva 2, 26 Linear Algebra (1 of them the 2022 exam, plus 2 newer exam
     solutions), 1 Group Theory, 0 unknown. The "Needs classification" section
     above renders only when unknownVideos is non-empty. Course tags/filters
     are driven by src/data/courses.ts (courseFor). The full Linear Algebra
     archive (songs, memory aids, more worked solutions) lives at
     /teaching/linear-algebra. */
  }

  <script>
    import "../scripts/teaching-discovery";
  </script>
</Layout>

<style>
  .teaching-shortcuts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid #dce4d6; border-radius: 12px; background: #fafbf7; overflow: hidden; }
  .teaching-shortcuts > div { display: flex; flex-direction: column; align-items: start; padding: 1.5rem; }
  .teaching-shortcuts > div + div { border-left: 1px solid #dce4d6; }
  .teaching-shortcuts .shortcut-meta { margin: 0 0 0.65rem; color: #607459; font-size: 0.6875rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.045em; }
  .teaching-shortcuts h2 { font-family: var(--font-family-display); font-size: 1.375rem; color: #294437; line-height: 1.25; }
  .teaching-shortcuts p:not(.shortcut-meta) { flex: 1; margin: 0.625rem 0 0.75rem; color: #5e6d61; font-size: 0.8125rem; line-height: 1.75; }
  .teaching-shortcuts a { display: inline-flex; align-items: center; min-height: 36px; color: #1b4e3f; font-size: 0.8125rem; font-weight: 650; text-decoration: underline; text-decoration-color: #c5d3c7; text-underline-offset: 4px; }
  .teaching-shortcuts a:hover { text-decoration-color: currentColor; }
  .shortcut-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .course-heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.75rem; }
  .course-heading > p { max-width: 20rem; color: #647067; font-size: 0.8125rem; line-height: 1.75; }
  .archive-heading { margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid #e2e8dd; scroll-margin-top: 7rem; }
  .archive-heading h2 { margin-bottom: 0.75rem; }
  .archive-heading p:not(.edition-label) { color: #5e6d61; font-size: 0.875rem; line-height: 1.75; }
  .archive-heading p.archive-access-note { margin-top: 0.625rem; font-size: 0.75rem; }
  .archive-filter { margin-top: 1.75rem; }
  .archive-filter button { border: 1px solid #c6d2c4; border-radius: 999px; padding: 0.625rem 1rem; background: white; color: #43624f; font-size: 0.8125rem; font-weight: 600; cursor: pointer; }
  .archive-filter button[aria-pressed="true"] { background: #244f3e; color: white; border-color: #244f3e; }
  .archive-filter button:hover { border-color: #244f3e; }
  .archive-filter button:focus-visible { outline: 3px solid #8cb7a1; outline-offset: 3px; }
  [data-course-results] { margin-top: 0.75rem; color: #647067; font-size: 0.8125rem; }
  [data-teaching-archive] [hidden] { display: none !important; }
  @media (max-width: 767px) {
    .teaching-shortcuts { grid-template-columns: 1fr; }
    .teaching-shortcuts > div { padding: 1.25rem; }
    .teaching-shortcuts > div + div { border-left: 0; border-top: 1px solid #dce4d6; }
    .course-heading { align-items: start; flex-direction: column; gap: 0.75rem; }
    .course-heading > p { max-width: none; }
  }
</style>
