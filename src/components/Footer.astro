---
const year = new Date().getFullYear();
const groups = [
  { title: "For students", links: [
    { href: "/teaching/2026-2027", label: "Courses · 2026–2027" },
    { href: "/teaching", label: "Teaching archive" },
    { href: "/teaching/linear-algebra/lab/en/", label: "Interactive linear algebra" },
    { href: "/students", label: "Student Hub" },
  ] },
  { title: "Academic", links: [
    { href: "/research", label: "Research" },
    { href: "/projects", label: "Projects & code" },
    { href: "/cv", label: "Curriculum vitae" },
    { href: "/about", label: "About" },
  ] },
  { title: "Explore", links: [
    { href: "/quantum-community", label: "Quantum community" },
    { href: "/quantum-community/events", label: "Events & past meetings" },
    { href: "/reading", label: "Reading & resources" },
    { href: "/search", label: "Search the website" },
  ] },
];
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-intro">
        <a href="/" class="site-brand">
          <img src="/brand/chen-favicon-v2.png" alt="" width="36" height="36" loading="lazy" />
          <span>Chen Gadi</span>
        </a>
        <p>M.Sc. student in Physics under Prof. Yaron Oz. Teaching and quantum community at Tel Aviv University.</p>
        <a class="text-link" href="/contact">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
      {groups.map((group) => (
        <nav aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul role="list">{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="site-footer-bottom">
      <p>&copy; {year} Chen Gadi</p>
      <p>Physics · Teaching · Quantum Community</p>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>
