---
const navLinks = [
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/teaching", label: "Teaching" },
  { href: "/quantum-community", label: "Community" },
  { href: "/cv", label: "CV" },
  { href: "/contact", label: "Contact" },
];
const mobileLinks = [...navLinks,
  { href: "/reading", label: "Reading" },
  { href: "/about", label: "About" },
  { href: "/students", label: "Student Hub" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => pathname === href || pathname.startsWith(href + "/");
---

<header class="site-header" id="top">
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="site-brand" aria-label="Chen Gadi home">
      <img src="/brand/chen-favicon-v2.png" alt="" width="36" height="36" />
      <span>Chen Gadi<span class="site-brand-detail">Physics · Tel Aviv University</span></span>
    </a>
    <ul class="site-desktop-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li><a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a></li>
      ))}
    </ul>
    <div class="site-nav-actions">
      <a class="site-search-trigger" href="/search" data-search-open aria-label="Search the website">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
        <span class="site-search-word">Search</span>
      </a>
      <button class="site-appearance-button" id="appearance-toggle" type="button" aria-label="Use paper background" aria-pressed="false" title="Switch between white and paper backgrounds">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 8h6M9 12h6M9 16h4"></path></svg>
        <span>Paper</span>
      </button>
      <a class="site-student-link" href="/students" aria-current={isActive("/students") ? "page" : undefined}>Student Hub <span aria-hidden="true">↗</span></a>
      <button id="nav-toggle" class="site-menu-toggle" type="button" aria-label="Open navigation" aria-controls="nav-menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </nav>
  <nav id="nav-menu" class="site-mobile-menu" aria-label="Mobile navigation" hidden>
    <ul role="list">
      {mobileLinks.map(({ href, label }) => (
        <li><a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}<span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </nav>
  <noscript><style>.site-appearance-button,.site-menu-toggle{display:none!important}@media(max-width:1199px){#nav-menu[hidden]{display:block!important}}</style></noscript>
</header>
